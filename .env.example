# === Obrigatorio ===
# Chave da API transacional do Brevo. Gere uma chave NOVA e revogue a antiga (foi exposta).
# Brevo > SMTP & API > API Keys.
BREVO_API_KEY=xkeysib-COLOQUE_UMA_NOVA_CHAVE_AQUI

# === Para o comando de teste (npm run test-send) ===
# Endereco que recebe 1 email de cada step, ignorando a regua, para validar visual e SPF/DKIM/DMARC.
TEST_EMAIL=voce@exemplo.com

# === Opcionais ===
# Renovacao semanal automatica: quando ligado (1), depois que o FRI20 de uma semana ja passou,
# o worker avanca a DATA_WEBINAR do contato para a proxima quarta, fazendo a regua rodar de novo.
# Padrao 0 (desligado) por seguranca. Leia o README antes de ligar.
AUTO_ROLLOVER=0

# Atraso em milissegundos entre chamadas de envio (respeito ao rate limit do Brevo). Padrao 150.
SEND_DELAY_MS=150
