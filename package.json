{
  "name": "webinar-mailer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Motor de envio da regua semanal do webinario megamemory via API transacional do Brevo",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "setup": "node --env-file=.env --import tsx scripts/setup-brevo.ts",
    "worker": "node --env-file=.env --import tsx src/worker.ts",
    "dry-run": "node --env-file=.env --import tsx src/worker.ts --dry-run",
    "test-send": "node --env-file=.env --import tsx src/test-send.ts",
    "check-time": "node --env-file=.env --import tsx scripts/check-time.ts",
    "start:prod": "node dist/src/worker.js"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
